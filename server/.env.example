# -----------------------------------------------------------------------------
# Magnet Frame Pro — License Server environment variables
# -----------------------------------------------------------------------------
# Copy this file to .env and adjust before deploying.
# All variables have sensible defaults so the server boots out of the box.

# Admin bootstrap credentials. On first boot, if the admin_users table is
# empty, a single admin user is seeded with these values. After that, the
# password stored in the DB is the source of truth; changing this env var
# does NOT update an already-seeded user.
#
# USE A STRONG PASSWORD: 16+ chars, mix letters/numbers/symbols.
# Example: "Mp@2026!QzKj7vXyN3#a"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME-TO-SOMETHING-LONG-AND-RANDOM

# Secret key for signing session cookies / tokens.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-ME-32-CHAR-RANDOM-STRING

# Comma-separated list of allowed CORS origins. In production this MUST
# be your real domain(s) only. Leave defaults for local dev.
MFP_ALLOWED_ORIGINS=https://magnetframepro.co.il,https://www.magnetframepro.co.il,http://127.0.0.1:8000

# Name of the session cookie set on the admin browser.
SESSION_COOKIE_NAME=admin_session

# Path to the SQLite database file, relative to the server/ folder (or an
# absolute path). On Railway set this to a path inside the mounted Volume
# so data survives deploys. Recommended: "/data/licenses.db" with a
# Volume mounted at /data.
DATABASE_PATH=licenses.db

# Session lifetime in days (default 30).
SESSION_LIFETIME_DAYS=30

# -----------------------------------------------------------------------------
# Email delivery (SMTP) — used to send license keys to customers after a
# successful purchase. If SMTP_HOST is empty, emails are silently skipped
# (the license is still created; operator can resend later).
# -----------------------------------------------------------------------------
# Gmail: enable 2FA, then create an App Password under Google account →
# Security → App passwords. Use the 16-char app password below (NOT your
# normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=PHOTO.ME.PM1@GMAIL.COM
SMTP_PASSWORD=app-password-from-google
SMTP_FROM=PHOTO.ME.PM1@GMAIL.COM
SMTP_FROM_NAME=Magnet Frame PRO
# STARTTLS (port 587); set to false and use SMTP_USE_SSL=true for port 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# -----------------------------------------------------------------------------
# Payment webhook — shared secret used to verify HMAC-SHA256 signatures on
# incoming POST /webhook/payment/* requests. Generate a long random string
# and configure the same value in your payment provider's dashboard. If
# empty, signature verification is skipped (acceptable in DEV only).
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=
